<Window
    x:Class="DataGrid.Groupby.Demo.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    Title="DataGrid Demo"
    Width="1280"
    Height="720"
    MinWidth="960"
    MinHeight="540"
    mc:Ignorable="d">
    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter" />
        <Style x:Key="MiddleAlignCellStyle" TargetType="TextBlock">
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
        <Style x:Key="RightAlignCellStyle" TargetType="TextBlock">
            <Setter Property="HorizontalAlignment" Value="Right" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
    </Window.Resources>

    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="12" />
            <RowDefinition Height="*" />
            <RowDefinition Height="12" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Border
            Grid.Row="0"
            Padding="16"
            Background="#F5F7FA"
            BorderBrush="#D7DCE2"
            BorderThickness="1"
            CornerRadius="8">
            <DockPanel LastChildFill="True">
                <StackPanel>
                    <TextBlock
                        FontSize="22"
                        FontWeight="SemiBold"
                        Text="车辆数据展示" />
                    <TextBlock
                        Margin="0,6,0,0"
                        Foreground="#5F6B7A"
                        Text="数据来源：cars.json，使用 WPF 内置 DataGrid。" />
                </StackPanel>
            </DockPanel>
        </Border>

        <Grid Grid.Row="2">
            <DataGrid
                x:Name="CarDataGrid"
                AutoGenerateColumns="False"
                CanUserAddRows="False"
                CanUserDeleteRows="False"
                CanUserResizeColumns="True"
                CanUserSortColumns="True"
                EnableColumnVirtualization="True"
                EnableRowVirtualization="True"
                IsReadOnly="True"
                ItemsSource="{Binding Cars}"
                MouseDoubleClick="GridControl_MouseDoubleClick"
                RowHeight="32"
                VirtualizingPanel.IsVirtualizing="True"
                VirtualizingPanel.IsVirtualizingWhenGrouping="True"
                VirtualizingPanel.ScrollUnit="Pixel"
                VirtualizingPanel.VirtualizationMode="Recycling">

                <DataGrid.Columns>
                    <DataGridTextColumn
                        Width="150"
                        Binding="{Binding Producer}"
                        ElementStyle="{StaticResource MiddleAlignCellStyle}"
                        Header="Producer" />
                    <DataGridTextColumn
                        Width="100"
                        Binding="{Binding CarClass}"
                        ElementStyle="{StaticResource MiddleAlignCellStyle}"
                        Header="Class" />
                    <DataGridTextColumn
                        Width="180"
                        Binding="{Binding Model}"
                        ElementStyle="{StaticResource MiddleAlignCellStyle}"
                        Header="Model" />
                    <DataGridTextColumn
                        Width="120"
                        Binding="{Binding EnergyType}"
                        ElementStyle="{StaticResource MiddleAlignCellStyle}"
                        Header="EnergyType" />
                    <DataGridTextColumn
                        Width="150"
                        Binding="{Binding LaunchDate, StringFormat=d}"
                        ElementStyle="{StaticResource MiddleAlignCellStyle}"
                        Header="LaunchDate" />
                    <DataGridTextColumn
                        Width="120"
                        Binding="{Binding BasePrice, StringFormat=C2}"
                        ElementStyle="{StaticResource RightAlignCellStyle}"
                        Header="BasePrice" />
                    <DataGridTextColumn
                        Width="120"
                        Binding="{Binding Insurance, StringFormat=C2}"
                        ElementStyle="{StaticResource RightAlignCellStyle}"
                        Header="Insurance" />
                    <DataGridTextColumn
                        Width="120"
                        Binding="{Binding Tax, StringFormat=C2}"
                        ElementStyle="{StaticResource RightAlignCellStyle}"
                        Header="Tax" />
                    <DataGridTextColumn
                        Width="140"
                        Binding="{Binding TotalPrice, StringFormat=C2}"
                        ElementStyle="{StaticResource RightAlignCellStyle}"
                        Header="TotalPrice" />
                </DataGrid.Columns>
            </DataGrid>

            <Grid Background="#80FFFFFF" Visibility="{Binding IsLoading, Converter={StaticResource BooleanToVisibilityConverter}}">
                <ProgressBar
                    Width="180"
                    Height="12"
                    VerticalAlignment="Center"
                    IsIndeterminate="True" />
            </Grid>
        </Grid>

        <DockPanel Grid.Row="4">
            <TextBlock
                VerticalAlignment="Center"
                Foreground="#5F6B7A"
                Text="{Binding StatusText}" />
            <ProgressBar
                Width="180"
                Height="12"
                Margin="12,0,0,0"
                VerticalAlignment="Center"
                IsIndeterminate="True"
                Visibility="{Binding IsLoading, Converter={StaticResource BooleanToVisibilityConverter}}" />
        </DockPanel>
    </Grid>
</Window>
