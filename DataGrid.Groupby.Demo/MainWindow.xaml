<Window
    x:Class="DataGrid.Groupby.Demo.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:syncfusion="http://schemas.syncfusion.com/wpf"
    Title="DataGrid GroupBy Demo"
    Width="1280"
    Height="720"
    MinWidth="960"
    MinHeight="540"
    mc:Ignorable="d">
    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter" />
    </Window.Resources>

    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="12" />
            <RowDefinition Height="*" />
            <RowDefinition Height="12" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Border
            Grid.Row="0"
            Padding="16"
            Background="#F5F7FA"
            BorderBrush="#D7DCE2"
            BorderThickness="1"
            CornerRadius="8">
            <DockPanel LastChildFill="True">
                <StackPanel>
                    <TextBlock
                        FontSize="22"
                        FontWeight="SemiBold"
                        Text="车辆数据分组展示" />
                    <TextBlock
                        Margin="0,6,0,0"
                        Foreground="#5F6B7A"
                        Text="数据来源：cars.json，按 Producer 和 Class 两级分组，使用 Syncfusion SfDataGrid。" />
                </StackPanel>
            </DockPanel>
        </Border>

        <Grid Grid.Row="2">
            <syncfusion:SfDataGrid
                x:Name="CarDataGrid"
                AllowEditing="False"
                AllowGrouping="False"
                AllowResizingColumns="False"
                AllowSorting="False"
                AutoExpandGroups="True"
                AutoGenerateColumns="False"
                ColumnSizer="Star"
                FrozenColumnCount="2"
                ItemsSource="{Binding Cars}"
                MouseDoubleClick="GridControl_MouseDoubleClick"
                ShowColumnWhenGrouped="True"
                ShowGroupDropArea="False"
                ShowRowHeader="False">

                <syncfusion:SfDataGrid.GroupColumnDescriptions>
                    <syncfusion:GroupColumnDescription ColumnName="Producer" />
                    <syncfusion:GroupColumnDescription ColumnName="CarClass" />
                </syncfusion:SfDataGrid.GroupColumnDescriptions>

                <syncfusion:SfDataGrid.SortColumnDescriptions>
                    <syncfusion:SortColumnDescription ColumnName="Producer" SortDirection="Ascending" />
                    <syncfusion:SortColumnDescription ColumnName="CarClass" SortDirection="Ascending" />
                    <syncfusion:SortColumnDescription ColumnName="Model" SortDirection="Ascending" />
                </syncfusion:SfDataGrid.SortColumnDescriptions>

                <syncfusion:SfDataGrid.GroupSummaryRows>
                    <syncfusion:GridSummaryRow ShowSummaryInRow="False">
                        <syncfusion:GridSummaryRow.SummaryColumns>
                            <syncfusion:GridSummaryColumn
                                Name="BasePriceSum"
                                Format="'{Sum:C2}'"
                                MappingName="BasePrice"
                                SummaryType="DoubleAggregate" />
                            <syncfusion:GridSummaryColumn
                                Name="InsuranceSum"
                                Format="'{Sum:C2}'"
                                MappingName="Insurance"
                                SummaryType="DoubleAggregate" />
                            <syncfusion:GridSummaryColumn
                                Name="TaxSum"
                                Format="'{Sum:C2}'"
                                MappingName="Tax"
                                SummaryType="DoubleAggregate" />
                            <syncfusion:GridSummaryColumn
                                Name="TotalPriceSum"
                                Format="'{Sum:C2}'"
                                MappingName="TotalPrice"
                                SummaryType="DoubleAggregate" />
                        </syncfusion:GridSummaryRow.SummaryColumns>
                    </syncfusion:GridSummaryRow>
                </syncfusion:SfDataGrid.GroupSummaryRows>

                <syncfusion:SfDataGrid.Columns>
                    <syncfusion:GridTextColumn
                        Width="150"
                        HeaderText="Producer"
                        MappingName="Producer" />
                    <syncfusion:GridTextColumn
                        Width="100"
                        HeaderText="Class"
                        MappingName="CarClass" />
                    <syncfusion:GridTextColumn
                        Width="180"
                        HeaderText="Model"
                        MappingName="Model" />
                    <syncfusion:GridTextColumn
                        Width="120"
                        HeaderText="EnergyType"
                        MappingName="EnergyType" />
                    <syncfusion:GridTextColumn
                        Width="150"
                        DisplayBinding="{Binding LaunchDate, StringFormat=d}"
                        HeaderText="LaunchDate"
                        MappingName="LaunchDate" />
                    <syncfusion:GridTextColumn
                        Width="120"
                        DisplayBinding="{Binding BasePrice, StringFormat=C2}"
                        HeaderText="BasePrice"
                        MappingName="BasePrice"
                        TextAlignment="Right" />
                    <syncfusion:GridTextColumn
                        Width="120"
                        DisplayBinding="{Binding Insurance, StringFormat=C2}"
                        HeaderText="Insurance"
                        MappingName="Insurance"
                        TextAlignment="Right" />
                    <syncfusion:GridTextColumn
                        Width="120"
                        DisplayBinding="{Binding Tax, StringFormat=C2}"
                        HeaderText="Tax"
                        MappingName="Tax"
                        TextAlignment="Right" />
                    <syncfusion:GridTextColumn
                        Width="140"
                        DisplayBinding="{Binding TotalPrice, StringFormat=C2}"
                        HeaderText="TotalPrice"
                        MappingName="TotalPrice"
                        TextAlignment="Right" />
                </syncfusion:SfDataGrid.Columns>
            </syncfusion:SfDataGrid>

            <Grid
                Background="#80FFFFFF"
                Visibility="{Binding IsLoading, Converter={StaticResource BooleanToVisibilityConverter}}">
                <ProgressBar
                    Width="180"
                    Height="12"
                    VerticalAlignment="Center"
                    IsIndeterminate="True" />
            </Grid>
        </Grid>

        <DockPanel Grid.Row="4">
            <TextBlock
                VerticalAlignment="Center"
                Foreground="#5F6B7A"
                Text="{Binding StatusText}" />
            <ProgressBar
                Width="180"
                Height="12"
                Margin="12,0,0,0"
                VerticalAlignment="Center"
                IsIndeterminate="True"
                Visibility="{Binding IsLoading, Converter={StaticResource BooleanToVisibilityConverter}}" />
        </DockPanel>
    </Grid>
</Window>
