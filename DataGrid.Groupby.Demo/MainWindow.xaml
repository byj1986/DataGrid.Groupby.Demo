<Window
    x:Class="DataGrid.Groupby.Demo.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="clr-namespace:DataGrid.Groupby.Demo.Converters"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:helpers="clr-namespace:DataGrid.Groupby.Demo.Helpers"
    xmlns:proxy="clr-namespace:DataGrid.Groupby.Demo.Models"
    Title="DataGrid Demo"
    Width="1280"
    Height="720"
    MinWidth="960"
    MinHeight="540"
    mc:Ignorable="d">
    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter" />
        <local:CheckedConverter x:Key="CheckedConverter" />
        <local:VisibilityToBoolConverter x:Key="VisibilityToBoolConverter" />
        <local:ColumnCheckedConverter x:Key="ColumnCheckedConverter"/>
        <!--  无动画 Expander（Visibility 即时切换，消除收起/展开卡顿）  -->
        <Style x:Key="GroupExpanderStyle" TargetType="Expander">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Expander">
                        <DockPanel>
                            <ToggleButton
                                Padding="{TemplateBinding Padding}"
                                HorizontalAlignment="Stretch"
                                HorizontalContentAlignment="Left"
                                Background="Transparent"
                                BorderThickness="0"
                                Content="{TemplateBinding Header}"
                                DockPanel.Dock="Top"
                                IsChecked="{Binding IsExpanded, RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay}">
                                <ToggleButton.Template>
                                    <ControlTemplate TargetType="ToggleButton">
                                        <Border Padding="{TemplateBinding Padding}" Background="Transparent">
                                            <StackPanel Orientation="Horizontal">
                                                <Path
                                                    x:Name="Arrow"
                                                    Width="7"
                                                    Height="7"
                                                    Margin="0,0,6,0"
                                                    VerticalAlignment="Center"
                                                    Data="M 0,0 L 6,3.5 L 0,7 Z"
                                                    Fill="#6B7280" />
                                                <ContentPresenter VerticalAlignment="Center" />
                                            </StackPanel>
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsChecked" Value="True">
                                                <Setter TargetName="Arrow" Property="Data" Value="M 0,0 L 6,0 L 3,6 Z" />
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </ToggleButton.Template>
                            </ToggleButton>
                            <ContentPresenter
                                x:Name="ExpandSite"
                                DockPanel.Dock="Bottom"
                                Focusable="False"
                                Visibility="Collapsed" />
                        </DockPanel>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsExpanded" Value="True">
                                <Setter TargetName="ExpandSite" Property="Visibility" Value="Visible" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!--  Producer 一级分组头  -->
        <Style x:Key="ProducerGroupItemStyle" TargetType="GroupItem">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="GroupItem">
                        <Expander
                            Padding="6,5"
                            IsExpanded="True"
                            Style="{StaticResource GroupExpanderStyle}">
                            <Expander.Header>
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock
                                        FontSize="13"
                                        FontWeight="Bold"
                                        Foreground="#1E3A5F"
                                        Text="{Binding Name}" />
                                    <TextBlock
                                        Margin="8,0,0,0"
                                        FontSize="12"
                                        Foreground="#5F6B7A">
                                        <Run Text="(" /><Run Text="{Binding ItemCount, Mode=OneWay}" />
                                        <Run Text=" 款)" />
                                    </TextBlock>
                                </StackPanel>
                            </Expander.Header>
                            <ItemsPresenter />
                        </Expander>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!--  CarClass 二级分组头  -->
        <Style x:Key="CarClassGroupItemStyle" TargetType="GroupItem">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="GroupItem">
                        <Expander
                            Padding="6,4"
                            IsExpanded="True"
                            Style="{StaticResource GroupExpanderStyle}">
                            <Expander.Header>
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock
                                        FontSize="12"
                                        Foreground="#3A6EA5"
                                        Text="{Binding Name}" />
                                    <TextBlock
                                        Margin="6,0,0,0"
                                        FontSize="12"
                                        Foreground="#8A97A4">
                                        <Run Text="(" /><Run Text="{Binding ItemCount, Mode=OneWay}" />
                                        <Run Text=" 款)" />
                                    </TextBlock>
                                </StackPanel>
                            </Expander.Header>
                            <ItemsPresenter />
                        </Expander>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!--  列可见性切换 MenuItem 公共样式  -->
        <Style x:Key="ColumnMenuItemStyle" TargetType="MenuItem">
            <Setter Property="StaysOpenOnClick" Value="True" />
            <Setter Property="Command" Value="{Binding ToggleColumnVisibilityCommand}" />
            <Setter Property="CommandParameter" Value="{Binding Header, RelativeSource={RelativeSource Self}}" />
            <!--<Setter Property="IsChecked" Value="{Binding Path=ColumnManager,Converter={StaticResource ColumnCheckedConverter},ConverterParameter={Binding Header, RelativeSource={RelativeSource Self}}}"/>-->
            <Setter Property="helpers:ColumnMenuItemHelper.AutoBindChecked" Value="True" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="MenuItem">
                        <StackPanel Orientation="Horizontal">
                            <CheckBox
                                VerticalAlignment="Center"
                                IsChecked="{TemplateBinding IsChecked}"
                                IsHitTestVisible="False" />
                            <TextBlock
                                Margin="6,0,0,0"
                                VerticalAlignment="Center"
                                Text="{TemplateBinding Header}" />
                        </StackPanel>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

    </Window.Resources>

    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="12" />
            <RowDefinition Height="*" />
            <RowDefinition Height="12" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Border
            Grid.Row="0"
            Padding="16"
            Background="#F5F7FA"
            BorderBrush="#D7DCE2"
            BorderThickness="1"
            CornerRadius="8">
            <DockPanel LastChildFill="True">
                <StackPanel>
                    <TextBlock
                        FontSize="22"
                        FontWeight="SemiBold"
                        Text="车辆数据展示" />
                    <TextBlock
                        Margin="0,6,0,0"
                        Foreground="#5F6B7A"
                        Text="数据来源：cars.merged.json，使用 WPF 内置 DataGrid。" />
                </StackPanel>
            </DockPanel>
        </Border>

        <Grid Grid.Row="2">
            <DataGrid
                x:Name="CarDataGrid"
                AutoGenerateColumns="False"
                CanUserAddRows="False"
                CanUserDeleteRows="False"
                CanUserResizeColumns="True"
                CanUserSortColumns="True"
                EnableColumnVirtualization="True"
                EnableRowVirtualization="True"
                IsReadOnly="True"
                ItemsSource="{Binding CarsView}"
                MouseDoubleClick="GridControl_MouseDoubleClick"
                RowHeight="32"
                VirtualizingPanel.IsVirtualizing="True"
                VirtualizingPanel.IsVirtualizingWhenGrouping="True"
                VirtualizingPanel.ScrollUnit="Pixel"
                VirtualizingPanel.VirtualizationMode="Recycling">
                <DataGrid.Resources>
                    <proxy:BindingProxy x:Key="ViewModelProxy" Data="{Binding}" />
                    <Style x:Key="MiddleAlignCellStyle" TargetType="TextBlock">
                        <Setter Property="VerticalAlignment" Value="Center" />
                    </Style>
                    <Style x:Key="RightAlignCellStyle" TargetType="TextBlock">
                        <Setter Property="HorizontalAlignment" Value="Right" />
                        <Setter Property="VerticalAlignment" Value="Center" />
                    </Style>

                </DataGrid.Resources>
                <!--<DataGrid.GroupStyle>
                    <GroupStyle ContainerStyle="{StaticResource ProducerGroupItemStyle}" />
                    <GroupStyle ContainerStyle="{StaticResource CarClassGroupItemStyle}" />
                </DataGrid.GroupStyle>-->

                <DataGrid.ContextMenu>
                    <ContextMenu DataContext="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource Self}}">
                        <MenuItem Header="Producer" Style="{StaticResource ColumnMenuItemStyle}" />
                        <MenuItem Header="CarClass" Style="{StaticResource ColumnMenuItemStyle}" />
                        <MenuItem Header="EnergyType" Style="{StaticResource ColumnMenuItemStyle}" />
                        <MenuItem Header="VIN" Style="{StaticResource ColumnMenuItemStyle}" />
                        <MenuItem Header="LaunchDate" Style="{StaticResource ColumnMenuItemStyle}" />
                        <MenuItem Header="BasePrice" Style="{StaticResource ColumnMenuItemStyle}" />
                        <MenuItem Header="Insurance" Style="{StaticResource ColumnMenuItemStyle}" />
                        <MenuItem Header="Tax" Style="{StaticResource ColumnMenuItemStyle}" />
                        <MenuItem Header="TotalPrice" Style="{StaticResource ColumnMenuItemStyle}" />
                    </ContextMenu>
                </DataGrid.ContextMenu>

                <DataGrid.Columns>
                    <DataGridTextColumn
                        Width="150"
                        Binding="{Binding Producer}"
                        ElementStyle="{StaticResource MiddleAlignCellStyle}"
                        Header="Producer" />
                    <DataGridTextColumn
                        Width="100"
                        Binding="{Binding CarClass}"
                        ElementStyle="{StaticResource MiddleAlignCellStyle}"
                        Header="Class" />
                    <DataGridTextColumn
                        Width="120"
                        Binding="{Binding EnergyType}"
                        ElementStyle="{StaticResource MiddleAlignCellStyle}"
                        Header="EnergyType" />
                    <DataGridTextColumn
                        Width="180"
                        Binding="{Binding VIN}"
                        ElementStyle="{StaticResource MiddleAlignCellStyle}"
                        Header="VIN" />
                    <DataGridTextColumn
                        Width="150"
                        Binding="{Binding LaunchDate, StringFormat=d}"
                        ElementStyle="{StaticResource MiddleAlignCellStyle}"
                        Header="LaunchDate" />
                    <DataGridTextColumn
                        Width="120"
                        Binding="{Binding BasePrice, StringFormat=C2}"
                        ElementStyle="{StaticResource RightAlignCellStyle}"
                        Header="BasePrice" />
                    <DataGridTextColumn
                        Width="120"
                        Binding="{Binding Insurance, StringFormat=C2}"
                        ElementStyle="{StaticResource RightAlignCellStyle}"
                        Header="Insurance" />
                    <DataGridTextColumn
                        Width="120"
                        Binding="{Binding Tax, StringFormat=C2}"
                        ElementStyle="{StaticResource RightAlignCellStyle}"
                        Header="Tax" />
                    <DataGridTextColumn
                        Width="140"
                        Binding="{Binding TotalPrice, StringFormat=C2}"
                        ElementStyle="{StaticResource RightAlignCellStyle}"
                        Header="TotalPrice" />
                </DataGrid.Columns>
            </DataGrid>

            <Grid Background="#80FFFFFF" Visibility="{Binding IsLoading, Converter={StaticResource BooleanToVisibilityConverter}}">
                <ProgressBar
                    Width="180"
                    Height="12"
                    VerticalAlignment="Center"
                    IsIndeterminate="True" />
            </Grid>
        </Grid>

        <DockPanel Grid.Row="4">
            <TextBlock
                VerticalAlignment="Center"
                Foreground="#5F6B7A"
                Text="{Binding StatusText}" />

            <ProgressBar
                Width="180"
                Height="12"
                Margin="12,0,0,0"
                VerticalAlignment="Center"
                IsIndeterminate="True"
                Visibility="{Binding IsLoading, Converter={StaticResource BooleanToVisibilityConverter}}" />

            <StackPanel
                Margin="5"
                HorizontalAlignment="Right"
                Orientation="Horizontal">
                <Button
                    Margin="20,0,20,0"
                    Command="{Binding HideColumnCommand}"
                    Content="隐藏Insurance" />
                <Button
                    Margin="20,0,20,0"
                    Command="{Binding ResetVisibilityCommand}"
                    Content="恢复默认列显示" />
                <RadioButton
                    Margin="2"
                    Content="View"
                    IsChecked="{Binding ColumnManager.CurrentScenario, Mode=TwoWay, Converter={StaticResource CheckedConverter}, ConverterParameter='View'}" />
                <RadioButton
                    Margin="2"
                    Content="Order"
                    IsChecked="{Binding ColumnManager.CurrentScenario, Mode=TwoWay, Converter={StaticResource CheckedConverter}, ConverterParameter='Order'}" />
            </StackPanel>
        </DockPanel>
    </Grid>
</Window>

