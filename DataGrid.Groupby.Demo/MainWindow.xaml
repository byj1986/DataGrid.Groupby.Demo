<Window
    x:Class="DataGrid.Groupby.Demo.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:converters="clr-namespace:DataGrid.Groupby.Demo.Converters"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:dxg="http://schemas.devexpress.com/winfx/2008/xaml/grid"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    Title="DataGrid GroupBy Demo"
    Width="1280"
    Height="720"
    MinWidth="960"
    MinHeight="540"
    mc:Ignorable="d">
    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter" />
        <converters:GroupValueLabelConverter x:Key="GroupValueLabelConverter" />
    </Window.Resources>

    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="12" />
            <RowDefinition Height="*" />
            <RowDefinition Height="12" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Border
            Grid.Row="0"
            Padding="16"
            Background="#F5F7FA"
            BorderBrush="#D7DCE2"
            BorderThickness="1"
            CornerRadius="8">
            <DockPanel LastChildFill="True">
                <StackPanel>
                    <TextBlock
                        FontSize="22"
                        FontWeight="SemiBold"
                        Text="车辆数据分组展示" />
                    <TextBlock
                        Margin="0,6,0,0"
                        Foreground="#5F6B7A"
                        Text="数据来源：cars.json，按 Producer 和 Class 两级分组，使用 DevExpress GridControl。" />
                </StackPanel>
            </DockPanel>
        </Border>

        <dxg:GridControl
            Grid.Row="2"
            ItemsSource="{Binding Cars}"
            PreviewMouseLeftButtonDown="GridControl_PreviewMouseLeftButtonDown"
            PreviewMouseRightButtonDown="GridControl_PreviewMouseRightButtonDown">
            <dxg:GridControl.GroupSummary>
                <dxg:GridSummaryItem
                    DisplayFormat="{}{0:N2}"
                    FieldName="BasePrice"
                    SummaryType="Sum" />
                <dxg:GridSummaryItem
                    DisplayFormat="{}{0:N2}"
                    FieldName="Insurance"
                    SummaryType="Sum" />
                <dxg:GridSummaryItem
                    DisplayFormat="{}{0:N2}"
                    FieldName="Tax"
                    SummaryType="Sum" />
                <dxg:GridSummaryItem
                    DisplayFormat="{}{0:N2}"
                    FieldName="TotalPrice"
                    SummaryType="Sum" />
            </dxg:GridControl.GroupSummary>
            <dxg:GridControl.Columns>
                <dxg:GridColumn
                    Width="150"
                    FieldName="Producer"
                    GroupIndex="0"
                    Header="Producer"
                    SortIndex="0"
                    SortOrder="Ascending">
                    <dxg:GridColumn.GroupValueTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding Value, Converter={StaticResource GroupValueLabelConverter}}" />
                        </DataTemplate>
                    </dxg:GridColumn.GroupValueTemplate>
                </dxg:GridColumn>
                <dxg:GridColumn
                    Width="100"
                    FieldName="CarClass"
                    GroupIndex="1"
                    Header="Class"
                    SortIndex="1"
                    SortOrder="Ascending">
                    <dxg:GridColumn.GroupValueTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding Value, Converter={StaticResource GroupValueLabelConverter}}" />
                        </DataTemplate>
                    </dxg:GridColumn.GroupValueTemplate>
                </dxg:GridColumn>
                <dxg:GridColumn
                    Width="180"
                    FieldName="Model"
                    Header="Model"
                    SortIndex="2"
                    SortOrder="Ascending" />
                <dxg:GridColumn
                    Width="100"
                    FieldName="EnergyType"
                    Header="EnergyType" />
                <dxg:GridColumn
                    Width="120"
                    FieldName="LaunchDate"
                    Header="LaunchDate">
                    <dxg:GridColumn.DisplayMemberBinding>
                        <Binding Path="LaunchDate" StringFormat="yyyy-MM-dd" />
                    </dxg:GridColumn.DisplayMemberBinding>
                </dxg:GridColumn>
                <dxg:GridColumn
                    Width="120"
                    FieldName="BasePrice"
                    Header="BasePrice">
                    <dxg:GridColumn.DisplayMemberBinding>
                        <Binding Path="BasePrice" StringFormat="N2" />
                    </dxg:GridColumn.DisplayMemberBinding>
                </dxg:GridColumn>
                <dxg:GridColumn
                    Width="120"
                    FieldName="Insurance"
                    Header="Insurance">
                    <dxg:GridColumn.DisplayMemberBinding>
                        <Binding Path="Insurance" StringFormat="N2" />
                    </dxg:GridColumn.DisplayMemberBinding>
                </dxg:GridColumn>
                <dxg:GridColumn
                    Width="120"
                    FieldName="Tax"
                    Header="Tax">
                    <dxg:GridColumn.DisplayMemberBinding>
                        <Binding Path="Tax" StringFormat="N2" />
                    </dxg:GridColumn.DisplayMemberBinding>
                </dxg:GridColumn>
                <dxg:GridColumn
                    Width="140"
                    FieldName="TotalPrice"
                    Header="TotalPrice">
                    <dxg:GridColumn.DisplayMemberBinding>
                        <Binding Path="TotalPrice" StringFormat="N2" />
                    </dxg:GridColumn.DisplayMemberBinding>
                </dxg:GridColumn>
            </dxg:GridControl.Columns>
            <dxg:GridControl.View>
                <dxg:TableView
                    AllowColumnFiltering="False"
                    AllowColumnMoving="False"
                    AllowEditing="False"
                    AllowFixedColumnMenu="False"
                    AllowGrouping="False"
                    AllowSorting="False"
                    AutoWidth="False"
                    ContextMenu="{x:Null}"
                    GroupSummaryDisplayMode="AlignByColumns"
                    ShowGridMenu="TableView_ShowGridMenu"
                    ShowGroupPanel="False"
                    ShowGroupedColumns="True"
                    ShowIndicator="False" />
            </dxg:GridControl.View>
        </dxg:GridControl>

        <DockPanel Grid.Row="4">
            <TextBlock
                VerticalAlignment="Center"
                Foreground="#5F6B7A"
                Text="{Binding StatusText}" />
            <ProgressBar
                Width="180"
                Height="12"
                Margin="12,0,0,0"
                VerticalAlignment="Center"
                IsIndeterminate="True"
                Visibility="{Binding IsLoading, Converter={StaticResource BooleanToVisibilityConverter}}" />
        </DockPanel>
    </Grid>
</Window>
