<Window
    x:Class="DataGrid.Groupby.Demo.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:converters="clr-namespace:DataGrid.Groupby.Demo.Converters"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    Title="DataGrid GroupBy Demo"
    Width="1280"
    Height="720"
    MinWidth="960"
    MinHeight="540"
    mc:Ignorable="d">
    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter" />
        <converters:GroupSumConverter x:Key="GroupSumConverter" />

        <!-- Shared GroupItem ControlTemplate: groups start collapsed -->
        <ControlTemplate x:Key="CollapsedGroupItemTemplate" TargetType="{x:Type GroupItem}">
            <Expander IsExpanded="False">
                <Expander.Header>
                    <ContentPresenter Content="{Binding}" ContentTemplate="{TemplateBinding ContentTemplate}" />
                </Expander.Header>
                <ItemsPresenter />
            </Expander>
        </ControlTemplate>

        <Style x:Key="CollapsedGroupItemStyle" TargetType="{x:Type GroupItem}">
            <Setter Property="Template" Value="{StaticResource CollapsedGroupItemTemplate}" />
        </Style>
    </Window.Resources>

    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="12" />
            <RowDefinition Height="*" />
            <RowDefinition Height="12" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Border
            Grid.Row="0"
            Padding="16"
            Background="#F5F7FA"
            BorderBrush="#D7DCE2"
            BorderThickness="1"
            CornerRadius="8">
            <DockPanel LastChildFill="True">
                <StackPanel>
                    <TextBlock
                        FontSize="22"
                        FontWeight="SemiBold"
                        Text="车辆数据分组展示" />
                    <TextBlock
                        Margin="0,6,0,0"
                        Foreground="#5F6B7A"
                        Text="数据来源：cars.json，按 Producer 和 Class 两级分组，使用 WPF 内置 DataGrid。" />
                </StackPanel>
            </DockPanel>
        </Border>

        <Grid Grid.Row="2">
            <DataGrid
                x:Name="CarDataGrid"
                AutoGenerateColumns="False"
                CanUserAddRows="False"
                CanUserDeleteRows="False"
                CanUserResizeColumns="False"
                CanUserSortColumns="False"
                FrozenColumnCount="2"
                IsReadOnly="True"
                ItemsSource="{Binding Cars}"
                MouseDoubleClick="GridControl_MouseDoubleClick">

                <DataGrid.GroupStyle>
                    <!-- Level 1: Producer — show group name only -->
                    <GroupStyle ContainerStyle="{StaticResource CollapsedGroupItemStyle}">
                        <GroupStyle.HeaderTemplate>
                            <DataTemplate>
                                <Border
                                    Padding="4,4"
                                    Background="#DDE3EC">
                                    <TextBlock
                                        FontSize="13"
                                        FontWeight="Bold"
                                        Foreground="#1F2937"
                                        Text="{Binding Name}" />
                                </Border>
                            </DataTemplate>
                        </GroupStyle.HeaderTemplate>
                    </GroupStyle>

                    <!-- Level 2: CarClass — show group name + column-aligned sums -->
                    <GroupStyle ContainerStyle="{StaticResource CollapsedGroupItemStyle}">
                        <GroupStyle.HeaderTemplate>
                            <DataTemplate>
                                <Border
                                    Padding="4,3"
                                    Background="#EEF0F5">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="120" />
                                            <ColumnDefinition Width="120" />
                                            <ColumnDefinition Width="120" />
                                            <ColumnDefinition Width="140" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock
                                            Grid.Column="0"
                                            FontWeight="SemiBold"
                                            Foreground="#374151"
                                            Text="{Binding Name}"
                                            VerticalAlignment="Center" />
                                        <TextBlock
                                            Grid.Column="1"
                                            Margin="0,0,4,0"
                                            Foreground="#374151"
                                            Text="{Binding Items, Converter={StaticResource GroupSumConverter}, ConverterParameter=BasePrice}"
                                            TextAlignment="Right"
                                            VerticalAlignment="Center" />
                                        <TextBlock
                                            Grid.Column="2"
                                            Margin="0,0,4,0"
                                            Foreground="#374151"
                                            Text="{Binding Items, Converter={StaticResource GroupSumConverter}, ConverterParameter=Insurance}"
                                            TextAlignment="Right"
                                            VerticalAlignment="Center" />
                                        <TextBlock
                                            Grid.Column="3"
                                            Margin="0,0,4,0"
                                            Foreground="#374151"
                                            Text="{Binding Items, Converter={StaticResource GroupSumConverter}, ConverterParameter=Tax}"
                                            TextAlignment="Right"
                                            VerticalAlignment="Center" />
                                        <TextBlock
                                            Grid.Column="4"
                                            Margin="0,0,4,0"
                                            Foreground="#374151"
                                            Text="{Binding Items, Converter={StaticResource GroupSumConverter}, ConverterParameter=TotalPrice}"
                                            TextAlignment="Right"
                                            VerticalAlignment="Center" />
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </GroupStyle.HeaderTemplate>
                    </GroupStyle>
                </DataGrid.GroupStyle>

                <DataGrid.Columns>
                    <DataGridTextColumn
                        Width="150"
                        Binding="{Binding Producer}"
                        Header="Producer" />
                    <DataGridTextColumn
                        Width="100"
                        Binding="{Binding CarClass}"
                        Header="Class" />
                    <DataGridTextColumn
                        Width="180"
                        Binding="{Binding Model}"
                        Header="Model" />
                    <DataGridTextColumn
                        Width="120"
                        Binding="{Binding EnergyType}"
                        Header="EnergyType" />
                    <DataGridTextColumn
                        Width="150"
                        Binding="{Binding LaunchDate, StringFormat=d}"
                        Header="LaunchDate" />
                    <DataGridTextColumn
                        Width="120"
                        Binding="{Binding BasePrice, StringFormat=C2}"
                        Header="BasePrice">
                        <DataGridTextColumn.ElementStyle>
                            <Style TargetType="TextBlock">
                                <Setter Property="HorizontalAlignment" Value="Right" />
                            </Style>
                        </DataGridTextColumn.ElementStyle>
                    </DataGridTextColumn>
                    <DataGridTextColumn
                        Width="120"
                        Binding="{Binding Insurance, StringFormat=C2}"
                        Header="Insurance">
                        <DataGridTextColumn.ElementStyle>
                            <Style TargetType="TextBlock">
                                <Setter Property="HorizontalAlignment" Value="Right" />
                            </Style>
                        </DataGridTextColumn.ElementStyle>
                    </DataGridTextColumn>
                    <DataGridTextColumn
                        Width="120"
                        Binding="{Binding Tax, StringFormat=C2}"
                        Header="Tax">
                        <DataGridTextColumn.ElementStyle>
                            <Style TargetType="TextBlock">
                                <Setter Property="HorizontalAlignment" Value="Right" />
                            </Style>
                        </DataGridTextColumn.ElementStyle>
                    </DataGridTextColumn>
                    <DataGridTextColumn
                        Width="140"
                        Binding="{Binding TotalPrice, StringFormat=C2}"
                        Header="TotalPrice">
                        <DataGridTextColumn.ElementStyle>
                            <Style TargetType="TextBlock">
                                <Setter Property="HorizontalAlignment" Value="Right" />
                            </Style>
                        </DataGridTextColumn.ElementStyle>
                    </DataGridTextColumn>
                </DataGrid.Columns>
            </DataGrid>

            <Grid
                Background="#80FFFFFF"
                Visibility="{Binding IsLoading, Converter={StaticResource BooleanToVisibilityConverter}}">
                <ProgressBar
                    Width="180"
                    Height="12"
                    VerticalAlignment="Center"
                    IsIndeterminate="True" />
            </Grid>
        </Grid>

        <DockPanel Grid.Row="4">
            <TextBlock
                VerticalAlignment="Center"
                Foreground="#5F6B7A"
                Text="{Binding StatusText}" />
            <ProgressBar
                Width="180"
                Height="12"
                Margin="12,0,0,0"
                VerticalAlignment="Center"
                IsIndeterminate="True"
                Visibility="{Binding IsLoading, Converter={StaticResource BooleanToVisibilityConverter}}" />
        </DockPanel>
    </Grid>
</Window>
